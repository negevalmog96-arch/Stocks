const STORAGE_KEY = "stockAnalyzerNoApi_v1";\
\
function defaultState() \{\
\
  return \{\
\
    budget:16000,\
\
    cash:0,\
\
    fee:0,\
\
    holdings:[],\
\
    watchlist:[]\
\
  \};\
\
\}\
\
function loadState() \{\
\
  try \{\
\
    const saved = localStorage.getItem(STORAGE_KEY);\
\
    if (!saved) return defaultState();\
\
    const data = JSON.parse(saved);\
\
    return \{\
\
      ...defaultState(),\
\
      ...data,\
\
      holdings:Array.isArray(data.holdings) ? data.holdings : [],\
\
      watchlist:Array.isArray(data.watchlist) ? data.watchlist : []\
\
    \};\
\
  \} catch \{\
\
    return defaultState();\
\
  \}\
\
\}\
\
let state = loadState();\
\
function persist() \{\
\
  localStorage.setItem(STORAGE_KEY, JSON.stringify(state));\
\
\}\
\
function number(id) \{\
\
  const value = Number(document.getElementById(id).value);\
\
  return Number.isFinite(value) ? value : 0;\
\
\}\
\
function text(id) \{\
\
  return document.getElementById(id).value.trim();\
\
\}\
\
function money(value, currency="ILS") \{\
\
  return new Intl.NumberFormat("he-IL", \{\
\
    style:"currency",\
\
    currency,\
\
    maximumFractionDigits:2\
\
  \}).format(value);\
\
\}\
\
function safe(value) \{\
\
  return String(value ?? "").replace(/[&<>"']/g, char => (\{\
\
    "&":"&amp;","<":"&lt;",">":"&gt;",\
\
    '"':"&quot;","'":"&#39;"\
\
  \})[char]);\
\
\}\
\
function saveBudget() \{\
\
  state.budget = Math.max(0, number("budget"));\
\
  state.cash = Math.max(0, number("cash"));\
\
  state.fee = Math.max(0, number("fee"));\
\
  persist();\
\
  render();\
\
\}\
\
function resetBudget() \{\
\
  document.getElementById("budget").value = 0;\
\
  document.getElementById("cash").value = 0;\
\
  document.getElementById("fee").value = 0;\
\
  saveBudget();\
\
\}\
\
function addHolding() \{\
\
  const symbol = text("symbol").toUpperCase();\
\
  const shares = number("shares");\
\
  const price = number("price");\
\
  const fx = number("fx");\
\
  if (!/^[A-Z0-9.-]\{1,12\}$/.test(symbol)) \{\
\
    alert("\uc0\u1492 \u1494 \u1503  \u1505 \u1497 \u1502 \u1493 \u1500  \u1502 \u1504 \u1497 \u1492  \u1514 \u1511 \u1497 \u1503 .");\
\
    return;\
\
  \}\
\
  if (shares <= 0 || price < 0 || fx <= 0) \{\
\
    alert("\uc0\u1489 \u1491 \u1493 \u1511  \u1488 \u1514  \u1499 \u1502 \u1493 \u1514  \u1492 \u1502 \u1504 \u1497 \u1493 \u1514 , \u1492 \u1502 \u1495 \u1497 \u1512  \u1493 \u1513 \u1506 \u1512  \u1492 \u1491 \u1493 \u1500 \u1512 .");\
\
    return;\
\
  \}\
\
  state.holdings.push(\{\
\
    id:Date.now().toString() + Math.random().toString(16).slice(2),\
\
    symbol, shares, price, fx\
\
  \});\
\
  persist();\
\
  document.getElementById("symbol").value = "";\
\
  document.getElementById("shares").value = "";\
\
  document.getElementById("price").value = "";\
\
  render();\
\
\}\
\
function updateHolding(id) \{\
\
  const item = state.holdings.find(x => x.id === id);\
\
  if (!item) return;\
\
  const newPrice = prompt("\uc0\u1492 \u1494 \u1503  \u1502 \u1495 \u1497 \u1512  \u1495 \u1491 \u1513  \u1489 \u1491 \u1493 \u1500 \u1512 \u1497 \u1501 :", item.price);\
\
  if (newPrice === null) return;\
\
  const price = Number(newPrice);\
\
  if (!Number.isFinite(price) || price < 0) \{\
\
    alert("\uc0\u1502 \u1495 \u1497 \u1512  \u1500 \u1488  \u1514 \u1511 \u1497 \u1503 .");\
\
    return;\
\
  \}\
\
  const newFx = prompt("\uc0\u1492 \u1494 \u1503  \u1513 \u1506 \u1512  \u1491 \u1493 \u1500 \u1512  \u1500 \u1513 \u1511 \u1500 :", item.fx);\
\
  if (newFx === null) return;\
\
  const fx = Number(newFx);\
\
  if (!Number.isFinite(fx) || fx <= 0) \{\
\
    alert("\uc0\u1513 \u1506 \u1512  \u1495 \u1500 \u1497 \u1508 \u1497 \u1503  \u1500 \u1488  \u1514 \u1511 \u1497 \u1503 .");\
\
    return;\
\
  \}\
\
  item.price = price;\
\
  item.fx = fx;\
\
  persist();\
\
  render();\
\
\}\
\
function removeHolding(id) \{\
\
  if (!confirm("\uc0\u1500 \u1502 \u1495 \u1493 \u1511  \u1488 \u1514  \u1492 \u1502 \u1504 \u1497 \u1492  \u1502 \u1492 \u1514 \u1497 \u1511 ?")) return;\
\
  state.holdings = state.holdings.filter(x => x.id !== id);\
\
  persist();\
\
  render();\
\
\}\
\
function addWatch() \{\
\
  const symbol = text("watchSymbol").toUpperCase();\
\
  const note = text("watchNote");\
\
  if (!/^[A-Z0-9.-]\{1,12\}$/.test(symbol)) \{\
\
    alert("\uc0\u1492 \u1494 \u1503  \u1505 \u1497 \u1502 \u1493 \u1500  \u1502 \u1504 \u1497 \u1492  \u1514 \u1511 \u1497 \u1503 .");\
\
    return;\
\
  \}\
\
  if (state.watchlist.some(x => x.symbol === symbol)) \{\
\
    alert("\uc0\u1492 \u1502 \u1504 \u1497 \u1492  \u1499 \u1489 \u1512  \u1504 \u1502 \u1510 \u1488 \u1514  \u1489 \u1512 \u1513 \u1497 \u1502 \u1514  \u1492 \u1502 \u1506 \u1511 \u1489 .");\
\
    return;\
\
  \}\
\
  state.watchlist.push(\{\
\
    id:Date.now().toString() + Math.random().toString(16).slice(2),\
\
    symbol,note\
\
  \});\
\
  persist();\
\
  document.getElementById("watchSymbol").value = "";\
\
  document.getElementById("watchNote").value = "";\
\
  render();\
\
\}\
\
function removeWatch(id) \{\
\
  state.watchlist = state.watchlist.filter(x => x.id !== id);\
\
  persist();\
\
  render();\
\
\}\
\
function calculatePotential() \{\
\
  const symbol = text("calcSymbol").toUpperCase();\
\
  const investment = number("calcInvestment");\
\
  const growth = number("calcGrowth");\
\
  if (investment < 0 || growth < -100) \{\
\
    alert("\uc0\u1489 \u1491 \u1493 \u1511  \u1488 \u1514  \u1505 \u1499 \u1493 \u1501  \u1492 \u1492 \u1513 \u1511 \u1506 \u1492  \u1493 \u1488 \u1514  \u1488 \u1495 \u1493 \u1494  \u1492 \u1513 \u1497 \u1504 \u1493 \u1497 .");\
\
    return;\
\
  \}\
\
  const profit = investment * growth / 100;\
\
  const finalValue = investment + profit;\
\
  const sign = profit > 0 ? "+" : "";\
\
  document.getElementById("calcResult").textContent =\
\
    (symbol ? "\uc0\u1502 \u1504 \u1497 \u1492 : " + symbol + "\\n" : "") +\
\
    "\uc0\u1505 \u1499 \u1493 \u1501  \u1492 \u1514 \u1495 \u1500 \u1514 \u1497 : " + money(investment) + "\\n" +\
\
    "\uc0\u1513 \u1497 \u1504 \u1493 \u1497  \u1502 \u1513 \u1493 \u1506 \u1512 : " + sign + money(profit) + "\\n" +\
\
    "\uc0\u1513 \u1493 \u1493 \u1497  \u1505 \u1493 \u1508 \u1497  \u1489 \u1514 \u1512 \u1495 \u1497 \u1513 : " + money(finalValue) + "\\n\\n" +\
\
    "\uc0\u1494 \u1492 \u1493  \u1514 \u1512 \u1495 \u1497 \u1513  \u1502 \u1514 \u1502 \u1496 \u1497  \u1489 \u1500 \u1489 \u1491 , \u1500 \u1488  \u1514 \u1495 \u1494 \u1497 \u1514  \u1500 \u1502 \u1495 \u1497 \u1512  \u1492 \u1502 \u1504 \u1497 \u1492 .";\
\
\}\
\
function analyzeStock() \{\
\
  const symbol = text("analysisSymbol").toUpperCase();\
\
  const growthRaw = text("analysisRevenue");\
\
  const growth = Number(growthRaw);\
\
  const profit = document.getElementById("analysisProfit").value;\
\
  const risk = document.getElementById("analysisRisk").value;\
\
  const notes = text("analysisNotes");\
\
  if (!symbol) \{\
\
    alert("\uc0\u1492 \u1494 \u1503  \u1505 \u1497 \u1502 \u1493 \u1500  \u1502 \u1504 \u1497 \u1492 .");\
\
    return;\
\
  \}\
\
  const profitText = \{\
\
    positive:"\uc0\u1492 \u1495 \u1489 \u1512 \u1492  \u1512 \u1493 \u1493 \u1495 \u1497 \u1514  \u1500 \u1508 \u1497  \u1492 \u1504 \u1514 \u1493 \u1504 \u1497 \u1501  \u1513 \u1492 \u1493 \u1494 \u1504 \u1493 .",\
\
    breakEven:"\uc0\u1492 \u1495 \u1489 \u1512 \u1492  \u1505 \u1489 \u1497 \u1489  \u1504 \u1511 \u1493 \u1491 \u1514  \u1492 \u1488 \u1497 \u1494 \u1493 \u1503  \u1500 \u1508 \u1497  \u1492 \u1504 \u1514 \u1493 \u1504 \u1497 \u1501  \u1513 \u1492 \u1493 \u1494 \u1504 \u1493 .",\
\
    negative:"\uc0\u1492 \u1495 \u1489 \u1512 \u1492  \u1506 \u1491 \u1497 \u1497 \u1503  \u1502 \u1508 \u1505 \u1497 \u1491 \u1492  \u1500 \u1508 \u1497  \u1492 \u1504 \u1514 \u1493 \u1504 \u1497 \u1501  \u1513 \u1492 \u1493 \u1494 \u1504 \u1493 .",\
\
    unknown:"\uc0\u1488 \u1497 \u1503  \u1502 \u1505 \u1508 \u1497 \u1511  \u1502 \u1497 \u1491 \u1506  \u1506 \u1500  \u1512 \u1493 \u1493 \u1495 \u1497 \u1493 \u1514  \u1492 \u1495 \u1489 \u1512 \u1492 ."\
\
  \}[profit];\
\
  const riskText = \{\
\
    low:"\uc0\u1505 \u1497 \u1499 \u1493 \u1503  \u1502 \u1513 \u1493 \u1506 \u1512  \u1504 \u1502 \u1493 \u1498  \u1497 \u1495 \u1505 \u1497 \u1514 .",\
\
    medium:"\uc0\u1505 \u1497 \u1499 \u1493 \u1503  \u1502 \u1513 \u1493 \u1506 \u1512  \u1489 \u1497 \u1504 \u1493 \u1504 \u1497 .",\
\
    high:"\uc0\u1505 \u1497 \u1499 \u1493 \u1503  \u1502 \u1513 \u1493 \u1506 \u1512  \u1490 \u1489 \u1493 \u1492 ."\
\
  \}[risk];\
\
  let growthText = "\uc0\u1500 \u1488  \u1492 \u1493 \u1494 \u1503  \u1504 \u1514 \u1493 \u1503  \u1510 \u1502 \u1497 \u1495 \u1514  \u1492 \u1499 \u1504 \u1505 \u1493 \u1514 .";\
\
  if (growthRaw !== "" && Number.isFinite(growth)) \{\
\
    growthText = "\uc0\u1510 \u1502 \u1497 \u1495 \u1514  \u1492 \u1499 \u1504 \u1505 \u1493 \u1514  \u1513 \u1492 \u1493 \u1494 \u1504 \u1492 : " + growth + "%.";\
\
  \}\
\
  document.getElementById("analysisResult").textContent =\
\
    "\uc0\u1505 \u1497 \u1499 \u1493 \u1501  \u1502 \u1504 \u1497 \u1492 : " + symbol + "\\n\\n" +\
\
    growthText + "\\n" +\
\
    profitText + "\\n" +\
\
    riskText + "\\n\\n" +\
\
    "\uc0\u1492 \u1506 \u1512 \u1493 \u1514  \u1513 \u1492 \u1493 \u1494 \u1504 \u1493 :\\n" + (notes || "\u1500 \u1488  \u1492 \u1493 \u1494 \u1504 \u1493  \u1492 \u1506 \u1512 \u1493 \u1514 .") +\
\
    "\\n\\n\uc0\u1492 \u1505 \u1497 \u1499 \u1493 \u1501  \u1502 \u1489 \u1493 \u1505 \u1505  \u1512 \u1511  \u1506 \u1500  \u1492 \u1504 \u1514 \u1493 \u1504 \u1497 \u1501  \u1513 \u1492 \u1494 \u1504 \u1514 . \u1492 \u1493 \u1488  \u1488 \u1497 \u1504 \u1493  \u1504 \u1497 \u1514 \u1493 \u1495  AI \u1488 \u1493  \u1492 \u1502 \u1500 \u1510 \u1514  \u1511 \u1504 \u1497 \u1497 \u1492 .";\
\
\}\
\
function clearAnalysis() \{\
\
  ["analysisSymbol","analysisRevenue","analysisNotes"].forEach(id => \{\
\
    document.getElementById(id).value = "";\
\
  \});\
\
  document.getElementById("analysisProfit").value = "positive";\
\
  document.getElementById("analysisRisk").value = "medium";\
\
  document.getElementById("analysisResult").textContent = "\uc0\u1492 \u1505 \u1497 \u1499 \u1493 \u1501  \u1497 \u1493 \u1508 \u1497 \u1506  \u1499 \u1488 \u1503 .";\
\
\}\
\
function render() \{\
\
  document.getElementById("budget").value = state.budget;\
\
  document.getElementById("cash").value = state.cash;\
\
  document.getElementById("fee").value = state.fee;\
\
  const totalValue = state.holdings.reduce(\
\
    (sum,x) => sum + x.shares * x.price * x.fx, 0\
\
  );\
\
  const totalShares = state.holdings.reduce((sum,x) => sum + x.shares, 0);\
\
  document.getElementById("statBudget").textContent = money(state.budget);\
\
  document.getElementById("statValue").textContent = money(totalValue);\
\
  document.getElementById("statCount").textContent = totalShares.toLocaleString("he-IL");\
\
  document.getElementById("statWatch").textContent = state.watchlist.length;\
\
  const available = Math.max(0, state.budget - state.cash);\
\
  const feeReserve = state.fee * state.holdings.length;\
\
  document.getElementById("budgetResult").textContent =\
\
    "\uc0\u1514 \u1511 \u1510 \u1497 \u1489  \u1499 \u1493 \u1500 \u1500 : " + money(state.budget) + "\\n" +\
\
    "\uc0\u1502 \u1494 \u1493 \u1502 \u1503  \u1494 \u1502 \u1497 \u1503 : " + money(state.cash) + "\\n" +\
\
    "\uc0\u1514 \u1511 \u1510 \u1497 \u1489  \u1492 \u1513 \u1511 \u1506 \u1492  \u1500 \u1508 \u1504 \u1497  \u1506 \u1502 \u1500 \u1493 \u1514 : " + money(available) + "\\n" +\
\
    "\uc0\u1492 \u1506 \u1512 \u1499 \u1514  \u1506 \u1502 \u1500 \u1493 \u1514  \u1500 \u1508 \u1497  \u1502 \u1505 \u1508 \u1512  \u1513 \u1493 \u1512 \u1493 \u1514  \u1489 \u1514 \u1497 \u1511 : " + money(feeReserve) + "\\n" +\
\
    "\uc0\u1492 \u1505 \u1499 \u1493 \u1501  \u1488 \u1497 \u1504 \u1493  \u1499 \u1493 \u1500 \u1500  \u1506 \u1502 \u1500 \u1493 \u1514  \u1502 \u1499 \u1497 \u1512 \u1492  \u1488 \u1493  \u1506 \u1500 \u1493 \u1497 \u1493 \u1514  \u1504 \u1493 \u1505 \u1508 \u1493 \u1514 .";\
\
  const holdingsBody = document.getElementById("holdingsBody");\
\
  holdingsBody.innerHTML = state.holdings.map(x => `\
\
    <tr>\
\
      <td><strong>$\{safe(x.symbol)\}</strong></td>\
\
      <td>$\{Number(x.shares).toLocaleString("he-IL")\}</td>\
\
      <td>$\{money(x.price,"USD")\}</td>\
\
      <td>$\{money(x.shares*x.price*x.fx)\}</td>\
\
      <td>\
\
        <button class="small secondary" onclick="updateHolding('$\{safe(x.id)\}')">\uc0\u1506 \u1491 \u1499 \u1493 \u1503 </button>\
\
        <button class="small danger" onclick="removeHolding('$\{safe(x.id)\}')">\uc0\u1502 \u1495 \u1497 \u1511 \u1492 </button>\
\
      </td>\
\
    </tr>\
\
  `).join("");\
\
  document.getElementById("holdingsEmpty").classList.toggle(\
\
    "hidden", state.holdings.length > 0\
\
  );\
\
  const watchBody = document.getElementById("watchBody");\
\
  watchBody.innerHTML = state.watchlist.map(x => `\
\
    <tr>\
\
      <td><strong>$\{safe(x.symbol)\}</strong></td>\
\
      <td>$\{safe(x.note || "\'97")\}</td>\
\
      <td><button class="small danger" onclick="removeWatch('$\{safe(x.id)\}')">\uc0\u1492 \u1505 \u1512 </button></td>\
\
    </tr>\
\
  `).join("");\
\
  document.getElementById("watchEmpty").classList.toggle(\
\
    "hidden", state.watchlist.length > 0\
\
  );\
\
\}\
\
function exportData() \{\
\
  const blob = new Blob([JSON.stringify(state,null,2)], \{\
\
    type:"application/json"\
\
  \});\
\
  const url = URL.createObjectURL(blob);\
\
  const a = document.createElement("a");\
\
  a.href = url;\
\
  a.download = "stock-portfolio-backup.json";\
\
  a.click();\
\
  URL.revokeObjectURL(url);\
\
  document.getElementById("dataMessage").textContent = "\uc0\u1511 \u1493 \u1489 \u1509  \u1492 \u1490 \u1497 \u1489 \u1493 \u1497  \u1504 \u1493 \u1510 \u1512 .";\
\
\}\
\
function importData(event) \{\
\
  const file = event.target.files?.[0];\
\
  if (!file) return;\
\
  const reader = new FileReader();\
\
  reader.onload = () => \{\
\
    try \{\
\
      const data = JSON.parse(reader.result);\
\
      if (!data || !Array.isArray(data.holdings) ||\
\
          !Array.isArray(data.watchlist)) \{\
\
        throw new Error("\uc0\u1508 \u1493 \u1512 \u1502 \u1496  \u1500 \u1488  \u1514 \u1511 \u1497 \u1503 ");\
\
      \}\
\
      state = \{\
\
        ...defaultState(),\
\
        ...data,\
\
        holdings:data.holdings,\
\
        watchlist:data.watchlist\
\
      \};\
\
      persist();\
\
      render();\
\
      document.getElementById("dataMessage").textContent = "\uc0\u1492 \u1490 \u1497 \u1489 \u1493 \u1497  \u1497 \u1493 \u1489 \u1488  \u1489 \u1492 \u1510 \u1500 \u1495 \u1492 .";\
\
    \} catch \{\
\
      alert("\uc0\u1500 \u1488  \u1504 \u1497 \u1514 \u1503  \u1500 \u1497 \u1497 \u1489 \u1488  \u1488 \u1514  \u1492 \u1511 \u1493 \u1489 \u1509 . \u1489 \u1491 \u1493 \u1511  \u1513 \u1494 \u1492 \u1493  \u1511 \u1493 \u1489 \u1509  \u1490 \u1497 \u1489 \u1493 \u1497  \u1502 \u1514 \u1488 \u1497 \u1501 .");\
\
    \}\
\
    event.target.value = "";\
\
  \};\
\
  reader.readAsText(file);\
\
\}\
\
function clearAll() \{\
\
  if (!confirm("\uc0\u1500 \u1502 \u1495 \u1493 \u1511  \u1488 \u1514  \u1499 \u1500  \u1514 \u1497 \u1511  \u1492 \u1492 \u1513 \u1511 \u1506 \u1493 \u1514 , \u1512 \u1513 \u1497 \u1502 \u1514  \u1492 \u1502 \u1506 \u1511 \u1489  \u1493 \u1492 \u1514 \u1511 \u1510 \u1497 \u1489  \u1492 \u1513 \u1502 \u1493 \u1512 ?")) return;\
\
  state = defaultState();\
\
  persist();\
\
  render();\
\
  document.getElementById("dataMessage").textContent = "\uc0\u1492 \u1504 \u1514 \u1493 \u1504 \u1497 \u1501  \u1504 \u1502 \u1495 \u1511 \u1493 .";\
\
\}\
\
render();\
\
</script>\
\
</body>\
\
</html>}